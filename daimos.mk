# Native DAIMOS KCC build. Source and object inventory is in MAKEFILE.
# Keep prerequisites grouped in readable lines (about 96 characters);
# use portable backslash continuations within the 256-character logical-line
# limit of native MAKE.  Do not regenerate at boot.
NATIVE_BUILD_DIR = B
KCC_NATIVE_FLAGS = -Pgnu99 -x=pdp6 -m=gas -DHOST_DAIMOS=1 -DHOST_UNIX=0 -I/OPTION/SOURCE/KCC/SELF/INCLUDE -I/OPTION/SOURCE/KCC/ABI
# Archive recipes use $^: ordered prerequisites, supported by GNU/BSD/DAIMOS MAKE.
# Do not apply this to DLINK: startup objects must precede archives.
NATIVE_DARC = /OPTION/BASE/EXEC/DARC
NATIVE_DLINK = /OPTION/BASE/EXEC/DLINK
NATIVE_RM = /SYSTEM/EXEC/RM
.PHONY: NATIVE INSTALL CLEAN
NATIVE: B B/KCPP.DXR B/KPARSE.DXR B/KGEN.DXR B/KOPT.DXR B/KCC.DXR
B:
	@/SYSTEM/EXEC/INSTALL -D -M 0777 B
B/KCPP1.DARC: B/CC-CPP.DOBJ B/CCASMB.DOBJ B/CCDATA-CPP.DOBJ B/CCERR-CPP.DOBJ
	@$(NATIVE_DARC) -O $@ $^
B/KCPP2.DARC: B/CCOUT-CPP.DOBJ B/CCPP.DOBJ B/CCPPOUT.DOBJ B/CCSYM-CPP.DOBJ
	@$(NATIVE_DARC) -O $@ $^
B/KCPP3.DARC: B/CCSRC.DOBJ
