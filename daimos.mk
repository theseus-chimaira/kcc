B/KCPP.DXR: BOOT/CRT0.DOBJ BOOT/BOOT.DOBJ BOOT/SYS.DOBJ BOOT/HELP.DOBJ B/KCPP1.DARC \
    B/KCPP2.DARC B/KCPP3.DARC BOOT/LIBC.DARC
	@$(NATIVE_DLINK) --DAIMOS-UUO-RELAX -B 020 -O $@ $^
